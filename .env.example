# Frontend Environment Variables (Vite)
# Copy this file to .env and fill in your actual credentials.

# Supabase Configuration (from Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Razorpay Configuration (from Razorpay Dashboard -> Settings -> API Keys)
# Use test key (rzp_test_...) for development; live key (rzp_live_...) for production
VITE_RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere

# Optional Analytics (Plausible or GA4)
VITE_ENABLE_ANALYTICS=false
VITE_PLAUSIBLE_DOMAIN=pankajtyping.com
